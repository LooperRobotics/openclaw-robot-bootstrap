# Keep this at latest by default, or pin to a release tag like 2026.2.26.
OPENCLAW_VERSION=latest

# Local state mount path.
OPENCLAW_STATE_PATH=./openclaw-state

# Optional: trace, debug, info, warn, error.
OPENCLAW_LOG_LEVEL=info

# Gateway password — only used if gateway.auth.mode is set to "password" in openclaw.json.
# Default onboarding uses token auth; leave this as a fallback if needed.
OPENCLAW_GATEWAY_PASSWORD=change-me

# Tailscale auth key — get one from https://login.tailscale.com/admin/settings/keys
# Only needed on first start; state is persisted in the tailscale-state volume after that.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# Hostname for this node in your tailnet (appears in MagicDNS).
TS_HOSTNAME=openclaw-gateway

# ROS Domain ID (0-232, default: 0). Isolate ROS networks by domain.
ROS_DOMAIN_ID=0

TAVILY_API_KEY=tvly_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX